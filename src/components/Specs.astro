---
import type { Series } from '../data/catalog';
import SPECS from '../data/specs.json';
interface Props { s: Series }
const { s } = Astro.props;
type Sheet = { source?: string; groups: [string, [string, string][]][] };
const all = SPECS as Record<string, Sheet>;
const whole = all[`${s.slug}::*`];
const sheets = whole ? [{ name: s.name, sheet: whole }] : s.variants.map((v) => ({ name: v.name, sheet: all[`${s.slug}::${v.name}`] })).filter((x) => x.sheet);
const id = (n: string) => 'sp-' + n.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
{sheets.length > 0 && (
  <section class="section-s" aria-labelledby="spec-h">
    <div class="container">
      <div class="head-l"><div><h2 id="spec-h">Specifications.</h2><p class="lead">Manufacturer specifications for each model in the series.</p></div></div>
      {sheets.length > 1 && (
        <div class="spec-tabs pills" role="tablist" aria-label="Choose a model">
          {sheets.map((x, i) => <button type="button" role="tab" class="spec-tab" id={id(x.name) + '-t'} aria-controls={id(x.name)} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><span>{x.name}</span></button>)}
        </div>
      )}
      {sheets.map((x, i) => (
        <div class="spec-panel" id={id(x.name)} role={sheets.length > 1 ? 'tabpanel' : undefined} aria-labelledby={sheets.length > 1 ? id(x.name) + '-t' : undefined} hidden={i > 0}>
          {x.sheet.groups.map(([g, rows]) => (
            <div class="spec-group">
              <h3>{g}</h3>
              <dl>{rows.map(([k, v]) => <div class={k ? undefined : 'full'}>{k && <dt>{k}</dt>}<dd set:html={v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\n/g, '<br />')} /></div>)}</dl>
            </div>
          ))}
          {x.sheet.source && <p class="hint spec-src">Source: {x.sheet.source}. Specifications can vary by region and model number.</p>}
        </div>
      ))}
    </div>
  </section>
)}
<script>
  document.querySelectorAll<HTMLElement>('.spec-tabs').forEach((tl) => {
    const tabs = [...tl.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const pick = (t: HTMLButtonElement) => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; pick(n); n.focus(); } });
    });
  });
</script>
