---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteDrawer from '../components/QuoteDrawer.astro';
import Icon from '../components/Icon.astro';
import { SITE, href, waLink } from '../lib/site';
interface Props { title: string; description: string; current?: string; noindex?: boolean; jsonld?: object }
const { title, description, current, noindex, jsonld } = Astro.props;
const preview = process.env.PREVIEW === '1';
// Staging builds stay out of search results until launch is approved: build with NOINDEX=1.
const blockIndex = noindex || preview || process.env.NOINDEX === '1';
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '/').replace(/\/index\/$/, '/'), Astro.site).toString();
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: SITE.company, foundingDate: SITE.founded, url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', streetAddress: 'Office M07, Al Makhtom Building, Naif Road', addressLocality: 'Deira, Dubai', addressCountry: 'AE' },
  contactPoint: { '@type': 'ContactPoint', telephone: SITE.whatsapp, contactType: 'sales', availableLanguage: ['English'] }
};
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {blockIndex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#082E26" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header current={current} />
  <QuoteDrawer />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />

  <div class="wa"><a class="wa-btn" href={waLink()} target="_blank" rel="noopener" aria-label={`Chat with sales on WhatsApp, ${SITE.whatsapp}`} data-track="whatsapp_click"><Icon name="wa" /></a></div>

  <div class="consent" id="consent" role="region" aria-label="Cookie consent" hidden>
    <p><b>Cookies.</b> Analytics run only if you allow them. <a class="link" href={href("/cookie-policy/")}>Cookie policy</a></p>
    <div><button class="btn btn-secondary btn-s" type="button" data-consent="essential">Essential only</button><button class="btn btn-secondary btn-s" type="button" data-consent="all">Allow analytics</button></div>
  </div>

  <script>
    // Consent: nothing non-essential loads until "all". GA4 is added here once a measurement ID exists.
    const KEY = 'wp-consent';
    const bar = document.getElementById('consent')!;
    let consent: string | null = null;
    try { consent = localStorage.getItem(KEY); } catch {}
    if (!consent) bar.hidden = false;
    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-consent]');
      if (!b) return;
      consent = b.dataset.consent!;
      try { localStorage.setItem(KEY, consent); } catch {}
      bar.hidden = true;
    });
    document.getElementById('cookie-settings')?.addEventListener('click', () => { bar.hidden = false; bar.querySelector('button')?.focus(); });
    (window as any).wpTrack = (event: string, data: Record<string, unknown> = {}) => {
      if (consent !== 'all') return;
      const w = window as any; (w.dataLayer = w.dataLayer || []).push({ event, ...data });
    };
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-track], a[href*="wa.me"], a[href*="/contact"]');
      if (!t) return;
      const ev = t.dataset.track || (t.getAttribute('href')!.includes('wa.me') ? 'whatsapp_click' : 'quote_click');
      (window as any).wpTrack(ev, { path: location.pathname });
    });
    // Reveal on scroll; content is visible without JS and with reduced motion.
    const els = document.querySelectorAll('.reveal');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) els.forEach((x) => x.classList.add('in'));
    else { const io = new IntersectionObserver((en) => en.forEach((x) => { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }), { rootMargin: '0px 0px -6% 0px' }); els.forEach((x) => io.observe(x)); }
  </script>
</body>
</html>
